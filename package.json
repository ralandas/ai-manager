  "description": "AI administrator agent for short-term rental (Telegram now, Max/Wapi later; Realty Calendar PMS)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
