# ---- Server ----
PORT=3000
PUBLIC_URL=https://your-vps-domain.example   # public HTTPS base URL used for webhooks
LOG_LEVEL=info

# ---- LLM (Gemini) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=            # <- Al will send this
GEMINI_MODEL=gemini-1.5-pro

# ---- Messenger ----
MESSENGER=telegram         # telegram | max
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_MODE=polling      # polling (no domain needed) | webhook (needs PUBLIC_URL + HTTPS)
TELEGRAM_WEBHOOK_SECRET=change-me   # secret path/header to verify Telegram calls (webhook mode)

# Max via Wapi (later)
WAPI_BASE_URL=
WAPI_TOKEN=

# Housekeeping chat (group chat id where cleaning tasks are posted)
HOUSEKEEPING_CHAT_ID=
# Owner chat id for booking/payment notifications and alerts
OWNER_CHAT_ID=

# ---- PMS: Realty Calendar ----
# No official API. Endpoints reverse-engineered from the web client.
# Auth = x-user-token header + session cookie. Server rejects requests with no UA.
PMS_PROVIDER=stub                    # stub | realtycalendar
RC_BASE_URL=https://realtycalendar.ru
RC_USER_TOKEN=                       # x-user-token (long-lived)
RC_COOKIE=                           # at minimum _realty-calendar_aws_session_production=...
RC_USER_AGENT=Mozilla/5.0
RC_DEFAULT_DEPOSIT=2500              # deposit amount (minor units) for payment link

# ---- Database ----
DATABASE_URL=postgres://user:pass@localhost:5432/ai_manager

# ---- Safety rails ----
AUTONOMY_ENABLED=true            # master kill-switch for autonomous actions
MAX_BOOKING_TOTAL=1000000        # reject bookings above this (currency minor units guard)
MIN_BOOKING_TOTAL=1000
